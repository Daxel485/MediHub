@model MediHub.Web.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Iniciar sesión</h1>

        @using (Html.BeginForm("Login", "Cuenta", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.CorreoElectronico, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control", type = "email", autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.CorreoElectronico, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Contrasena, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger" })
            </div>
            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.Recordarme, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.Recordarme, new { @class = "form-check-label" })
            </div>

            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        }

        <p class="text-muted mt-3 mb-0">
            ¿Aún no tiene cuenta? @Html.ActionLink("Regístrese", "Registro", "Cuenta")
        </p>
    </div>
</div>
