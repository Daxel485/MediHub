@model MediHub.Web.ViewModels.ConfiguracionFormViewModel
@{
    ViewBag.Title = "Nueva configuración";
}

<h1 class="h3 mb-3">Nueva configuración</h1>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.IdProveedor, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.IdProveedor, Model.Proveedores, "Seleccione un proveedor", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.IdProveedor, "", new { @class = "text-danger" })
    </div>
    @Html.Partial("_CamposConfiguracion", Model)

    <button type="submit" class="btn btn-primary">Guardar</button>
    @Html.ActionLink("Cancelar", "Index", new { idProveedor = Model.IdProveedor > 0 ? (int?)Model.IdProveedor : null }, new { @class = "btn btn-outline-secondary" })
}
