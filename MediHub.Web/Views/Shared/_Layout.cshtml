@using MediHub.Domain.Constants
@using MediHub.Web.Extensions
@{
    var autenticado = User.Identity.IsAuthenticated;
    var esAdministrador = User.IsInRole(Roles.Administrador);
    var esComprador = User.IsInRole(Roles.Comprador);
    var esProveedor = User.IsInRole(Roles.Proveedor);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MediHub</title>
    @Styles.Render("~/Content/css")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            @Html.ActionLink("MediHub", "Index", "Home", null, new { @class = "navbar-brand fw-semibold" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto">
                    @if (esAdministrador || esComprador)
                    {
                        <li class="nav-item">@Html.ActionLink("Proveedores", "Index", "Proveedores", null, new { @class = "nav-link" })</li>
                    }
                    @* Licitaciones: el Comprador las gestiona y el Proveedor ve las vigentes en su portal. *@
                    @if (esComprador)
                    {
                        <li class="nav-item">@Html.ActionLink("Licitaciones", "Index", "Licitaciones", null, new { @class = "nav-link" })</li>
                    }
                    @if (esProveedor)
                    {
                        <li class="nav-item">@Html.ActionLink("Licitaciones", "Index", "PortalProveedor", null, new { @class = "nav-link" })</li>
                    }
                    @if (esAdministrador)
                    {
                        <li class="nav-item">@Html.ActionLink("Configuraciones", "Index", "Configuraciones", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Usuarios", "Index", "Usuarios", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Reportes", "Index", "Reportes", null, new { @class = "nav-link" })</li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (autenticado)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @User.ObtenerNombreCompleto() <span class="badge bg-light text-primary ms-1">@User.ObtenerRol()</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>@Html.ActionLink("Mi perfil", "Perfil", "Cuenta", null, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    @using (Html.BeginForm("CerrarSesion", "Cuenta", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("Iniciar sesión", "Login", "Cuenta", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Registrarse", "Registro", "Cuenta", null, new { @class = "nav-link" })</li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <main class="container body-content">
        @Html.Partial("_Alertas")
        @RenderBody()
    </main>
    <footer class="container text-muted small border-top mt-4 pt-3">
        &copy; @DateTime.Now.Year MediHub · Clínica Integral San Rafael
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
