@using MediHub.Domain.Constants
@using MediHub.Web.Extensions
@{
    ViewBag.Title = "Inicio";
    var esAdministrador = User.IsInRole(Roles.Administrador);
    var esComprador = User.IsInRole(Roles.Comprador);
    var esProveedor = User.IsInRole(Roles.Proveedor);
}

<div class="py-4">
    <h1 class="h2">MediHub</h1>
    <p class="lead text-muted">Plataforma de abastecimiento y licitaciones de la Clínica Integral San Rafael.</p>
    <p class="mb-0">Bienvenido(a), <strong>@User.ObtenerNombreCompleto()</strong> (@User.ObtenerRol()).</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    @if (esAdministrador || esComprador)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Proveedores</h2>
                    <p class="card-text">Droguerías, distribuidores y laboratorios afiliados, y la configuración de cada uno.</p>
                    @Html.ActionLink("Ver proveedores", "Index", "Proveedores", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    }
    @if (esComprador || esProveedor)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Licitaciones</h2>
                    <p class="card-text">Licitaciones publicadas y sincronización de las ofertas recibidas.</p>
                    @if (esProveedor)
                    {
                        @Html.ActionLink("Licitaciones vigentes", "Index", "PortalProveedor", null, new { @class = "btn btn-primary" })
                    }
                    else
                    {
                        @Html.ActionLink("Gestionar licitaciones", "Index", "Licitaciones", null, new { @class = "btn btn-primary" })
                    }
                </div>
            </div>
        </div>
    }
    @if (esAdministrador)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Reportes mensuales</h2>
                    <p class="card-text">Montos ofertados y comisiones generadas por proveedor en cada mes.</p>
                    @Html.ActionLink("Ver reportes", "Index", "Reportes", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    }
</div>
