@model IEnumerable<MediHub.Application.DTOs.UsuarioDto>
@{
    ViewBag.Title = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
    @Html.ActionLink("Nuevo usuario", "Crear", null, new { @class = "btn btn-primary" })
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombres</th>
                <th>Primer apellido</th>
                <th>Segundo apellido</th>
                <th>Identificación</th>
                <th>Correo electrónico</th>
                <th>Proveedor</th>
                <th>Fecha de registro</th>
                <th>Fecha de modificación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Nombres</td>
                    <td>@usuario.PrimerApellido</td>
                    <td>@usuario.SegundoApellido</td>
                    <td>@usuario.Identificacion</td>
                    <td>@usuario.CorreoElectronico</td>
                    <td>@usuario.NombreProveedor</td>
                    <td>@usuario.FechaDeRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(usuario.FechaDeModificacion.HasValue ? usuario.FechaDeModificacion.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                    <td>@Html.Partial("_Estado", usuario.Estado)</td>
                    <td>@Html.ActionLink("Editar", "Editar", new { id = usuario.IdUsuario }, new { @class = "btn btn-sm btn-outline-primary" })</td>
                </tr>
            }
        </tbody>
    </table>
</div>
