@model MediHub.Web.ViewModels.LicitacionOfertasViewModel
@{
    ViewBag.Title = "Ofertas · " + Model.Licitacion.Titulo;
}

<div class="mb-3">
    <h1 class="h3 mb-0">@Model.Licitacion.Titulo</h1>
    <p class="text-muted mb-1">@Model.Licitacion.Descripcion</p>
    <p class="small mb-1">Cierre: @Model.Licitacion.FechaDeCierre.ToString("dd/MM/yyyy")</p>
    @Html.ActionLink("← Volver a licitaciones", "Index", null, new { @class = "small" })
</div>

@if (!Model.Ofertas.Any())
{
    <p class="text-muted">Esta licitación todavía no tiene ofertas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Proveedor</th>
                    <th>Descripción</th>
                    <th class="text-end">Monto</th>
                    <th>Fecha de envío</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oferta in Model.Ofertas)
                {
                    <tr>
                        <td>@oferta.NombreProveedor</td>
                        <td>@oferta.Descripcion</td>
                        <td class="text-end">₡@oferta.Monto.ToString("N2")</td>
                        <td>@oferta.FechaDeEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (oferta.Sincronizada)
                            {
                                <span class="badge text-bg-success">Sincronizada</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">No sincronizada</span>
                            }
                        </td>
                        <td>
                            @if (!oferta.Sincronizada)
                            {
                                using (Html.BeginForm("Sincronizar", "Licitaciones", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("idOferta", oferta.IdOferta)
                                    @Html.Hidden("idLicitacion", oferta.IdLicitacion)
                                    <button type="submit" class="btn btn-sm btn-primary">Sincronizar</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
