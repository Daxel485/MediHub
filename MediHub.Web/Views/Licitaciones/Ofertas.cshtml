@model MediHub.Application.DTOs.ComparacionOfertasDto
@{
    var licitacion = Model.Licitacion;
    ViewBag.Title = licitacion.Titulo;
}

<div class="mb-4">
    @Html.ActionLink("Volver a licitaciones", "Index")
    <h1 class="h3 mt-2">@licitacion.Titulo @Html.Partial("_EstadoLicitacion", Model.EstadoDelProceso)</h1>
    <p>@licitacion.Descripcion</p>
    <p>Fin de recepción el @licitacion.FechaDeCierre.ToString("dd/MM/yyyy HH:mm")</p>
</div>

@* Las acciones del ciclo de vida dependen del estado actual de la licitación (patrón State). *@
<div class="d-flex flex-wrap gap-2 mb-4">
    @if (Model.PuedePublicar)
    {
        using (Html.BeginForm("Publicar", "Licitaciones", new { id = licitacion.IdLicitacion }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Publicar y notificar a proveedores</button>
        }
    }
    @if (Model.PuedeIniciarEvaluacion)
    {
        using (Html.BeginForm("IniciarEvaluacion", "Licitaciones", new { id = licitacion.IdLicitacion }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning">Pasar a evaluación</button>
        }
    }
    @if (Model.PuedeCerrar)
    {
        using (Html.BeginForm("Cerrar", "Licitaciones", new { id = licitacion.IdLicitacion }, FormMethod.Post,
            new { onsubmit = "return confirm('¿Desea cerrar la licitación? Esta acción no se puede deshacer.');" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">Cerrar licitación</button>
        }
    }
</div>

@if (!Model.RecepcionCerrada)
{
    <p class="text-muted">Los montos y los detalles estarán disponibles al finalizar la recepción de ofertas.</p>
}
else if (!Model.Ofertas.Any())
{
    <p class="text-muted">No se recibieron ofertas.</p>
}
else
{
    <h2 class="h5">Ofertas recibidas</h2>
    <div class="table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Proveedor</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" class="text-end">Monto total</th>
                    <th scope="col">Plazo (días)</th>
                    <th scope="col">Fecha de envío</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oferta in Model.Ofertas)
                {
                    <tr>
                        <th scope="row">@oferta.NombreProveedor</th>
                        <td>@oferta.Descripcion</td>
                        <td class="text-end">₡@oferta.Monto.ToString("N2")</td>
                        <td>@(oferta.PlazoEntregaDias?.ToString() ?? "Sin dato")</td>
                        <td>@oferta.FechaDeEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (Model.IdOfertaGanadora == oferta.IdOferta)
                            {
                                <span class="badge text-bg-success">Ganadora</span>
                            }
                            @if (Model.PuedeAdjudicar && oferta.Sincronizada)
                            {
                                using (Html.BeginForm("Adjudicar", "Licitaciones", new { id = licitacion.IdLicitacion },
                                    FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Confirma la adjudicación de esta oferta? Se notificará a todos los oferentes.');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idOferta" value="@oferta.IdOferta" />
                                    <button type="submit" class="btn btn-sm btn-primary">Adjudicar</button>
                                }
                            }
                            @if (!oferta.Sincronizada && Model.PermiteSincronizarOfertas)
                            {
                                using (Html.BeginForm("Sincronizar", "Licitaciones", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idOferta" value="@oferta.IdOferta" />
                                    <input type="hidden" name="idLicitacion" value="@licitacion.IdLicitacion" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Sincronizar</button>
                                }
                            }
                            @if (oferta.Sincronizada)
                            {
                                <span class="badge text-bg-secondary">Sincronizada</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    var filasPorItem = Model.Ofertas
        .SelectMany(oferta => oferta.Detalles.Select(detalle => new { Oferta = oferta, Detalle = detalle }))
        .GroupBy(fila => fila.Detalle.IdItemLicitacion)
        .OrderBy(grupo => grupo.Key)
        .ToList();
    <h2 class="h5">Comparación por ítem</h2>
    if (Model.Ofertas.Any(oferta => oferta.Detalles.Count == 0))
    {
        <p class="text-muted">Las ofertas registradas antes del portal aparecen en el resumen con su monto global.</p>
    }
    foreach (var grupo in filasPorItem)
    {
        <h3 class="h6 mt-3">@grupo.First().Detalle.DescripcionItem</h3>
        <div class="table-responsive pb-2">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Proveedor</th>
                        <th scope="col" class="text-end">Cantidad</th>
                        <th scope="col" class="text-end">Precio unitario</th>
                        <th scope="col">Vencimiento del lote</th>
                        <th scope="col" class="text-end">Puntaje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in grupo.OrderByDescending(f => f.Detalle.Puntaje))
                    {
                        <tr>
                            <th scope="row">@fila.Oferta.NombreProveedor</th>
                            <td class="text-end">@fila.Detalle.Cantidad.ToString("0.####")</td>
                            <td class="text-end">₡@fila.Detalle.PrecioUnitario.ToString("N2")</td>
                            <td>@fila.Detalle.FechaVencimientoLote.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@(fila.Detalle.Puntaje?.ToString("0.##") ?? "Pendiente")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
